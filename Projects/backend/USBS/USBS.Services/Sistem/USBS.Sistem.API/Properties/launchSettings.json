{
  "profiles": {
    "Sistem.API-Development": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "environmentVariables": {
        "USE_DOCKER": "false",
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "https://localhost:24200;http://localhost:24201"
    },
    "Container (Dockerfile)": {
      "commandName": "Docker",
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}",
      "environmentVariables": {
        "ASPNETCORE_HTTPS_PORTS": "24200",
        "ASPNETCORE_HTTP_PORTS": "24201"
      },
      "publishAllPorts": true,
      "useSSL": true
    },
    "Sistem.API-Docker": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Docker",
        "USE_DOCKER": "true"
      },
      "applicationUrl": "https://localhost:24200;http://localhost:24201",
      "dotnetRunMessages": true
    }
  },
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "iisSettings": {
    "windowsAuthentication": false,
    "anonymousAuthentication": true,
    "iisExpress": {
      "applicationUrl": "http://localhost:24200",
      "sslPort": 24199
    }
  }
}