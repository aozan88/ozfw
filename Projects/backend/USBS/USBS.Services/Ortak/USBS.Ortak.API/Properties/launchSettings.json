{
  "profiles": {
    "Ortak.API-Development": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "environmentVariables": {
        "USE_DOCKER": "false",
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "https://localhost:24100;http://localhost:24101"
    },
    "Container (Dockerfile)": {
      "commandName": "Docker",
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}",
      "environmentVariables": {
        "ASPNETCORE_HTTPS_PORTS": "24100",
        "ASPNETCORE_HTTP_PORTS": "24101"
      },
      "publishAllPorts": true,
      "useSSL": true
    },
    "Ortak.API-Docker": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Docker",
        "USE_DOCKER": "true"
      },
      "applicationUrl": "https://localhost:24100;http://localhost:24101",
      "dotnetRunMessages": true
    }
  },
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "iisSettings": {
    "windowsAuthentication": false,
    "anonymousAuthentication": true,
    "iisExpress": {
      "applicationUrl": "http://localhost:24100",
      "sslPort": 24099
    }
  }
}