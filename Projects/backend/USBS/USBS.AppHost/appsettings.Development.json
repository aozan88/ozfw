{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "KafkaEventBus": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "usbs-consumer",
    "ClientId": "usbs-producer",
