{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "{{ m.Name }}.API-Development": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "USE_DOCKER": "false"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "https://localhost:{{ m.HttpsPort }};http://localhost:{{ m.HttpPort }}"
    }
  }
}
