<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.21" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="{{ m.Paths.ToRepoRoot }}\Frameworks\OzFw\OzFw.ApiBase\OzFw.ApiBase.csproj" />
    <ProjectReference Include="..\..\..\{{ m.NamespaceRoot }}.ServiceDefaults\{{ m.NamespaceRoot }}.ServiceDefaults.csproj" />
    <ProjectReference Include="..\{{ m.ProjectPrefix }}.Application\{{ m.ProjectPrefix }}.Application.csproj" />
    <ProjectReference Include="..\{{ m.ProjectPrefix }}.Data\{{ m.ProjectPrefix }}.Data.csproj" />
  </ItemGroup>

</Project>
